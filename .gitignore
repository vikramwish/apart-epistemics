# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# OS, Editor & Agent Scratch
.DS_Store
*.bak
*.tmp
*.cpgz
.vscode/
.idea/
.claude/
.cursor/
.gemini/
CLAUDE.md
AGENTS.md
tmp/

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# New run output and local design/agent artifacts are not submission evidence.
/results/*
!/results/README.md
!/results/polyphony-p0-p4/
!/results/polyphony-p0-p4-12task-alpha03/
!/results/polyphony-controls/
!/results/polyphony-replication-2025/
/_local_archive/
/.assets/
/.designs/
/output/

# Large raw replication logs are available separately; hashes are in PROVENANCE.md.
/results/polyphony-replication-2025/numeric_runs.jsonl
/results/polyphony-replication-2025/provider_requests.jsonl
/results/polyphony-replication-2025/dry_run/

# Keep manuscript source, figures, fonts and final PDF; exclude build intermediates.
reports/**/*.aux
reports/**/*.bbl
reports/**/*.blg
reports/**/*.log
reports/**/*.out
reports/**/*.toc
reports/**/*.fls
reports/**/*.fdb_latexmk
reports/**/*.synctex.gz
reports/**/*.xdv
