# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local run artifacts. results/ tracks only the runs behind the submitted paper and its
# replication; earlier pilot/exploratory runs stay local-only.
/results/*
!/results/README.md
!/results/polyphony-p0-p4/
!/results/polyphony-p0-p4-12task-alpha03/
!/results/polyphony-controls/
!/results/polyphony-replication-2025/
reports/results/*.jsonl
tmp/
.DS_Store
node_modules/
/frontend/test-results/
/frontend/playwright-report/


/frontend/.designs/
*.cpgz

# LaTeX build byproducts (sources and final PDFs stay tracked)
reports/**/*.aux
reports/**/*.bbl
reports/**/*.blg
reports/**/*.log
reports/**/*.out
reports/**/*.synctex.gz
reports/**/__pycache__/

# Raw replication traces exceed GitHub's 100 MB limit; SHA-256 checksums are
# recorded in results/polyphony-replication-2025/PROVENANCE.md.
/results/polyphony-replication-2025/numeric_runs.jsonl
/results/polyphony-replication-2025/provider_requests.jsonl
/results/polyphony-replication-2025/dry_run/
